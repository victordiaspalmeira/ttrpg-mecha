[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://scripts/data/encounter_data.gd" id="1_enc"]
[ext_resource type="Script" path="res://scripts/data/encounter_spawn.gd" id="2_spawn"]
[ext_resource type="Script" path="res://scripts/data/team_data.gd" id="3_team"]
[ext_resource type="Resource" path="res://data/templates/assault.tres" id="4_player"]
[ext_resource type="Resource" path="res://data/templates/bastion.tres" id="5_player2"]
[ext_resource type="Resource" path="res://data/templates/sniper.tres" id="6_player3"]
[ext_resource type="Resource" path="res://data/templates/assault_enemy.tres" id="7_enemy1"]
[ext_resource type="Resource" path="res://data/templates/sniper_enemy.tres" id="8_enemy2"]

[sub_resource type="Resource" id="spawn_player1"]
script = ExtResource("2_spawn")
template = ExtResource("4_player")
q = 0
r = 0

[sub_resource type="Resource" id="spawn_player2"]
script = ExtResource("2_spawn")
template = ExtResource("5_player2")
q = 1
r = 0

[sub_resource type="Resource" id="spawn_player3"]
script = ExtResource("2_spawn")
template = ExtResource("6_player3")
q = 0
r = 1

[sub_resource type="Resource" id="spawn_enemy1"]
script = ExtResource("2_spawn")
template = ExtResource("7_enemy1")
q = 4
r = -2

[sub_resource type="Resource" id="spawn_enemy2"]
script = ExtResource("2_spawn")
template = ExtResource("8_enemy2")
q = 5
r = -3

[sub_resource type="Resource" id="team_player"]
script = ExtResource("3_team")
team_id = "player"
display_name = "Player Team"
is_player = true

[sub_resource type="Resource" id="team_enemy"]
script = ExtResource("3_team")
team_id = "enemy"
display_name = "Enemy Team"
outline_color = Color(1, 0.32, 0.24, 1)
hp_bar_full_color = Color(1, 0.32, 0.24, 1)

[resource]
script = ExtResource("1_enc")
encounter_id = "test_skirmish"
display_name = "Test Skirmish"
grid_radius = 5
teams = [SubResource("team_player"), SubResource("team_enemy")]
spawns = [SubResource("spawn_player1"), SubResource("spawn_player2"), SubResource("spawn_player3"), SubResource("spawn_enemy1"), SubResource("spawn_enemy2")]